<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Maffinet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#08141B</item>
        <item name="android:statusBarColor">#08141B</item>
        <item name="android:navigationBarColor">#08141B</item>
    </style>

    <style name="Theme.Maffinet.Splash" parent="Theme.SplashScreen">
