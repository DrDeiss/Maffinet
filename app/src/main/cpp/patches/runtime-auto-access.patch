+static int ensure_auto_capacity(struct buffer **buffer, size_t capacity)
+{
+    if (!*buffer) return -1;
+    if ((*buffer)->size >= capacity) return 0;
+    /* buff_pop may return a smaller pooled buffer. Keep queued bytes and the
+     * original allocation on ENOMEM; its owning connection will clean up. */
+    struct buffer *grown = realloc(*buffer, sizeof(**buffer) + capacity);
+    if (!grown) return -1;
+    grown->size = capacity;
+    *buffer = grown;
+    return 0;
+}
